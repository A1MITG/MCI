# Copy to .env and fill in. Never commit .env.

# Search provider: change this ONE value to swap providers.
# One of: tavily | brave | exa | fixture
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# Model provider (anthropic | fixture). Model names live in config/harness.config.json.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Where study workspaces are kept (git-ignored).
DATA_DIR=./data/studies

PORT=3000
